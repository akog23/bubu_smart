    {
      "type": "table",
      "title": "O que precisa ser feito agora",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "rawSql": "WITH ult AS (\n  SELECT id_bueiro, endereco, volume_l, capacidade_l, ocupacao_pct, status, time,\n         ROW_NUMBER() OVER (PARTITION BY id_bueiro ORDER BY time DESC) AS ordem\n  FROM \"leituras\"\n  WHERE time >= $__timeFrom AND time <= $__timeTo AND volume_l IS NOT NULL\n),\nlim AS (\n  SELECT id_bueiro, resultado,\n         ROW_NUMBER() OVER (PARTITION BY id_bueiro ORDER BY time DESC) AS ordem\n  FROM \"limpezas\"\n  WHERE time >= $__timeFrom AND time <= $__timeTo\n),\nbase AS (\n  SELECT u.id_bueiro, u.endereco, u.volume_l, u.capacidade_l, u.ocupacao_pct, u.status, l.resultado,\n         (CAST(now() AS BIGINT) - CAST(u.time AS BIGINT)) / 1000000000 AS seg\n  FROM ult u\n  LEFT JOIN lim l ON u.id_bueiro = l.id_bueiro AND l.ordem = 1\n  WHERE u.ordem = 1\n),\nclassif AS (\n  SELECT *,\n         CASE WHEN status = 'vermelho' AND resultado = 'nao_resolvida' THEN 1\n              WHEN seg > 30 THEN 2\n              WHEN status = 'vermelho' THEN 3\n              WHEN status = 'amarelo' THEN 4\n              ELSE 5 END AS prioridade\n  FROM base\n)\nSELECT prioridade AS \"Prioridade\",\n       id_bueiro  AS \"Bueiro\",\n       endereco   AS \"Endereço\",\n       CASE prioridade\n            WHEN 1 THEN 'Grade não resolveu'\n            WHEN 2 THEN 'Sem comunicação'\n            WHEN 3 THEN 'Crítico: grade em limpeza'\n            WHEN 4 THEN 'Atenção'\n            ELSE 'Normal' END AS \"Situação\",\n       CASE prioridade\n            WHEN 1 THEN 'Enviar equipe para limpeza manual'\n            WHEN 2 THEN 'Verificar o dispositivo no local'\n            WHEN 3 THEN 'Aguardar verificação automática (15 s)'\n            WHEN 4 THEN 'Acompanhar; programar limpeza se continuar subindo'\n            ELSE 'Nenhuma ação' END AS \"O que fazer\",\n       ocupacao_pct AS \"Ocupação (%)\",\n       volume_l     AS \"Resíduos (L)\",\n       CASE WHEN capacidade_l * 0.75 - volume_l > 0 THEN capacidade_l * 0.75 - volume_l ELSE 0 END AS \"Falta até o crítico (L)\",\n       CASE WHEN seg < 0 THEN 0 ELSE seg END AS \"Última leitura há\"\nFROM classif\nORDER BY prioridade, id_bueiro",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "description": "Um bueiro por linha, do mais urgente para o menos urgente, com a situação atual e a ação recomendada para a equipe.",
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Prioridade"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
