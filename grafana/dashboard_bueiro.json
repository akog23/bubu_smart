          "refId": "A",
          "rawSql": "SELECT time, id_bueiro, ocupacao_pct\nFROM \"leituras\"\nWHERE time >= $__timeFrom AND time <= $__timeTo AND volume_l IS NOT NULL\nORDER BY time",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "description": "Evolução do volume de resíduos em relação à capacidade de cada caixa. As quedas logo após ultrapassar 75% mostram a atuação da grade autolimpante.",
      "transformations": [
