    {
      "type": "barchart",
      "title": "Eficácia da grade autolimpante por bueiro",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 9,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "rawSql": "SELECT id_bueiro AS \"Bueiro\",\n       SUM(CASE WHEN resultado = 'resolvida'     THEN 1 ELSE 0 END) AS \"Resolvidas pela grade\",\n       SUM(CASE WHEN resultado = 'nao_resolvida' THEN 1 ELSE 0 END) AS \"Encaminhadas à equipe\"\nFROM \"limpezas\"\nWHERE time >= $__timeFrom AND time <= $__timeTo\nGROUP BY id_bueiro\nORDER BY id_bueiro",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "description": "Bueiros com muitas limpezas encaminhadas à equipe recebem resíduos grandes com frequência e devem ter prioridade na rota de zeladoria.",
      "options": {
